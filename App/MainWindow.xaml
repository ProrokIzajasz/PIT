<Window x:Class="PIT.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PIT - Play In Time"
        Width="1320"
        Height="760"
        MinWidth="1100"
        MinHeight="650"
        Background="#202020">

    <Window.Resources>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#3A3A3A"/>
            <Setter Property="Foreground" Value="#F0F0F0"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="#F0F0F0"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Padding" Value="5,2"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="BorderBrush" Value="#555555"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F0F0F0"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#181818"/>
            <Setter Property="Foreground" Value="#F0F0F0"/>
            <Setter Property="BorderBrush" Value="#444444"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="#181818"/>
            <Setter Property="Foreground" Value="#F0F0F0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="0,1"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#3A6EA5"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#333333"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#181818"/>
            <Setter Property="Foreground" Value="#F0F0F0"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="RowBackground" Value="#242424"/>
            <Setter Property="AlternatingRowBackground" Value="#2B2B2B"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#3A3A3A"/>
            <Setter Property="VerticalGridLinesBrush" Value="#3A3A3A"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#111111"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="Padding" Value="6,5"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="#242424"/>
            <Setter Property="Foreground" Value="#F0F0F0"/>
            <Setter Property="MinHeight" Value="54"/>
            <Setter Property="Margin" Value="0,2"/>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#2B2B2B"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#353535"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#3A6EA5"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F0F0F0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="6,3"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#3A6EA5"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="#3A6EA5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="390"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#2B2B2B"
                CornerRadius="12"
                Padding="12"
                Margin="0,0,12,0">

            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="PIT"
                           Foreground="White"
                           FontSize="28"
                           FontWeight="Bold"
                           Margin="0,0,0,4"/>

                <TextBlock DockPanel.Dock="Top"
                           Text="Play In Time"
                           Foreground="#BBBBBB"
                           FontSize="14"
                           Margin="0,0,0,18"/>

                <Button DockPanel.Dock="Bottom"
                        Content="Utwórz profil testowy"
                        Command="{Binding CreateSampleProfileCommand}"
                        Height="36"
                        Margin="0,12,0,0"/>

                <StackPanel>
                    <TextBlock Text="Profile"
           Foreground="White"
           FontWeight="SemiBold"
           Margin="0,0,0,6"/>

                    <TextBlock Text="Nazwa profilu"
           Foreground="#CCCCCC"
           Margin="0,0,0,4"/>

                    <TextBox Text="{Binding SelectedProfileName, UpdateSourceTrigger=PropertyChanged}"
         Height="28"
         Margin="0,0,0,8"/>

                    <ListBox ItemsSource="{Binding Profiles}"
         SelectedItem="{Binding SelectedProfile}"
         DisplayMemberPath="Name"
         Height="220"/>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
            Content="Dodaj"
            Command="{Binding AddProfileCommand}"
            Height="34"/>

                        <Button Grid.Column="2"
            Content="Usuń"
            Command="{Binding DeleteProfileCommand}"
            Height="34"/>
                    </Grid>

                    <Button Content="Zapisz profil"
        Command="{Binding SaveSelectedProfileCommand}"
        Height="34"
        Margin="0,8,0,0"/>
                    <Separator Margin="0,14,0,12"/>

                    <TextBlock Text="Przypisania myszy"
           Foreground="White"
           FontWeight="SemiBold"
           Margin="0,0,0,8"/>

                    <TextBlock Text="Mouse4 / XButton1"
           Foreground="#CCCCCC"
           Margin="0,0,0,4"/>

                    <ComboBox ItemsSource="{Binding TriggerTargetKinds}"
          SelectedItem="{Binding Mouse4TargetKind}"
          Height="30"
          Margin="0,0,0,6"/>

                    <ComboBox ItemsSource="{Binding CurrentMacros}"
          SelectedItem="{Binding Mouse4AssignedMacro}"
          DisplayMemberPath="Name"
          Visibility="{Binding Mouse4MacroBindingVisibility}"
          Height="30"
          Margin="0,0,0,6"/>

                    <ComboBox ItemsSource="{Binding CurrentSchemes}"
          SelectedItem="{Binding Mouse4AssignedScheme}"
          DisplayMemberPath="Name"
          Visibility="{Binding Mouse4SchemeBindingVisibility}"
          Height="30"
          Margin="0,0,0,6"/>

                    <ComboBox ItemsSource="{Binding TriggerRunModes}"
          SelectedItem="{Binding Mouse4RunMode}"
          Height="30"
          Margin="0,0,0,6"/>

                    <TextBox Text="{Binding Mouse4RepeatCount, UpdateSourceTrigger=PropertyChanged}"
         Visibility="{Binding Mouse4RepeatCountVisibility}"
         Height="28"
         Margin="0,0,0,6"/>

                    <CheckBox Content="Blokuj oryginalne Mouse4"
          IsChecked="{Binding BlockMouse4OriginalAction}"
          Margin="0,0,0,10"/>
                    <TextBlock Text="Mouse5 / XButton2"
           Foreground="#CCCCCC"
           Margin="0,0,0,4"/>

                    <ComboBox ItemsSource="{Binding TriggerTargetKinds}"
          SelectedItem="{Binding Mouse5TargetKind}"
          Height="30"
          Margin="0,0,0,6"/>

                    <ComboBox ItemsSource="{Binding CurrentMacros}"
          SelectedItem="{Binding Mouse5AssignedMacro}"
          DisplayMemberPath="Name"
          Visibility="{Binding Mouse5MacroBindingVisibility}"
          Height="30"
          Margin="0,0,0,6"/>

                    <ComboBox ItemsSource="{Binding CurrentSchemes}"
          SelectedItem="{Binding Mouse5AssignedScheme}"
          DisplayMemberPath="Name"
          Visibility="{Binding Mouse5SchemeBindingVisibility}"
          Height="30"
          Margin="0,0,0,6"/>

                    <ComboBox ItemsSource="{Binding TriggerRunModes}"
          SelectedItem="{Binding Mouse5RunMode}"
          Height="30"
          Margin="0,0,0,6"/>

                    <TextBox Text="{Binding Mouse5RepeatCount, UpdateSourceTrigger=PropertyChanged}"
         Visibility="{Binding Mouse5RepeatCountVisibility}"
         Height="28"
         Margin="0,0,0,6"/>

                    <CheckBox Content="Blokuj oryginalne Mouse5"
          IsChecked="{Binding BlockMouse5OriginalAction}"
          Margin="0,0,0,10"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Column="1"
        Background="#2B2B2B"
        CornerRadius="12"
        Padding="12"
        Margin="0,0,12,0">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0"
                   Margin="0,0,0,12">

                    <Button Content="Dodaj makro"
                    Command="{Binding AddMacroCommand}"
                    Width="105"
                    Height="36"
                    Margin="0,0,8,8"/>

                    <Button Content="Dodaj schemat"
                    Command="{Binding AddSchemeCommand}"
                    Width="115"
                    Height="36"
                    Margin="0,0,8,8"/>

                    <Button Content="Dodaj krok"
                    Command="{Binding AddStepCommand}"
                    Visibility="{Binding MacroWorkspaceVisibility}"
                    Width="95"
                    Height="36"
                    Margin="0,0,8,8"/>

                    <Button Content="↑"
                    Command="{Binding MoveStepUpCommand}"
                    Visibility="{Binding MacroWorkspaceVisibility}"
                    Width="42"
                    Height="36"
                    Margin="0,0,4,8"/>

                    <Button Content="↓"
                    Command="{Binding MoveStepDownCommand}"
                    Visibility="{Binding MacroWorkspaceVisibility}"
                    Width="42"
                    Height="36"
                    Margin="0,0,12,8"/>

                    <Button Content="Uruchom makro"
                    Command="{Binding RunSelectedMacroCommand}"
                    Visibility="{Binding MacroWorkspaceVisibility}"
                    Width="115"
                    Height="36"
                    Margin="0,0,8,8"/>

                    <Button Content="Uruchom schemat"
                    Command="{Binding RunSelectedSchemeCommand}"
                    Visibility="{Binding SchemeWorkspaceVisibility}"
                    Width="125"
                    Height="36"
                    Margin="0,0,8,8"/>

                    <Button Content="Stop"
                    Command="{Binding StopMacroCommand}"
                    Width="80"
                    Height="36"
                    Margin="0,0,8,8"/>

                    <Button Content="Nagrywaj"
                    Command="{Binding StartRecordingCommand}"
                    Visibility="{Binding MacroWorkspaceVisibility}"
                    Width="95"
                    Height="36"
                    Margin="0,0,8,8"/>

                    <Button Content="Stop REC"
                    Command="{Binding StopRecordingCommand}"
                    Visibility="{Binding MacroWorkspaceVisibility}"
                    Width="95"
                    Height="36"
                    Margin="0,0,8,8"/>

                    <TextBlock Text="{Binding RecordingStatus}"
                       Visibility="{Binding MacroWorkspaceVisibility}"
                       Foreground="#DDDDDD"
                       VerticalAlignment="Center"
                       Margin="4,0,0,8"/>
                </WrapPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: LISTS -->
                    <DockPanel Grid.Column="0"
                       Margin="0,0,12,0">

                        <TextBlock DockPanel.Dock="Top"
                           Text="Makra"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                        <TextBlock DockPanel.Dock="Top"
                           Text="Nazwa makra"
                           Foreground="#CCCCCC"
                           Margin="0,0,0,4"/>

                        <TextBox DockPanel.Dock="Top"
                         Text="{Binding SelectedMacroName, UpdateSourceTrigger=PropertyChanged}"
                         Height="28"
                         Margin="0,0,0,8"/>

                        <ListBox DockPanel.Dock="Top"
                         ItemsSource="{Binding CurrentMacros}"
                         SelectedItem="{Binding SelectedMacro}"
                         DisplayMemberPath="Name"
                         Height="170">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="Tag"
                                    Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}"/>

                                    <Setter Property="ContextMenu">
                                        <Setter.Value>
                                            <ContextMenu>
                                                <MenuItem Header="Usuń makro"
                                                  Command="{Binding PlacementTarget.Tag.DeleteMacroCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            </ContextMenu>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>

                        <Separator DockPanel.Dock="Top"
                           Margin="0,12,0,12"/>

                        <TextBlock DockPanel.Dock="Top"
                           Text="Schematy"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                        <ListBox DockPanel.Dock="Top"
                         ItemsSource="{Binding CurrentSchemes}"
                         SelectedItem="{Binding SelectedScheme}"
                         DisplayMemberPath="Name"
                         Height="170">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="Tag"
                                    Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}"/>

                                    <Setter Property="ContextMenu">
                                        <Setter.Value>
                                            <ContextMenu>
                                                <MenuItem Header="Usuń schemat"
                                                  Command="{Binding PlacementTarget.Tag.DeleteSchemeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            </ContextMenu>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </DockPanel>

                    <!-- MACRO WORKSPACE -->
                    <DockPanel Grid.Column="1"
                       Visibility="{Binding MacroWorkspaceVisibility}">

                        <TextBlock DockPanel.Dock="Top"
                           Text="Kroki makra"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                        <DataGrid ItemsSource="{Binding SelectedMacro.Steps}"
                          SelectedItem="{Binding SelectedStep}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          AlternationCount="2"
                          RowHeight="54"
                          FontSize="14">

                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                    <Setter Property="Tag"
                                    Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>

                                    <Setter Property="ContextMenu">
                                        <Setter.Value>
                                            <ContextMenu>
                                                <MenuItem Header="Usuń krok"
                                                  Command="{Binding PlacementTarget.Tag.DeleteStepCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            </ContextMenu>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGrid.RowStyle>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#"
                                            Binding="{Binding Order}"
                                            Width="45"/>

                                <DataGridTemplateColumn Header="" Width="64">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#343434"
                                            CornerRadius="10"
                                            Padding="6"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            MinWidth="44">
                                                <TextBlock Text="{Binding Icon}"
                                                   Foreground="White"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Krok" Width="3*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                   Foreground="White"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>

                                                <TextBlock Text="{Binding ActionLabel}"
                                                   Foreground="#BDBDBD"
                                                   FontSize="11"
                                                   Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Akcja"
                                            Binding="{Binding Action.Kind}"
                                            Width="140"/>

                                <DataGridCheckBoxColumn Header="Aktywny"
                                                Binding="{Binding IsEnabled}"
                                                Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <!-- SCHEME WORKSPACE -->
                    <DockPanel Grid.Column="1"
                       Visibility="{Binding SchemeWorkspaceVisibility}">

                        <TextBlock DockPanel.Dock="Top"
                           Text="Schemat"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                        <TextBlock DockPanel.Dock="Top"
                           Text="Paleta bloczków — przeciągnij bloczek na listę schematu"
                           Foreground="#CCCCCC"
                           Margin="0,0,0,8"/>

                        <WrapPanel DockPanel.Dock="Top"
                           Margin="0,0,0,12">

                            <Border Tag="RunMacro"
                            PreviewMouseMove="SchemePaletteItem_PreviewMouseMove"
                            Background="#343434"
                            CornerRadius="10"
                            Padding="10,7"
                            Margin="0,0,8,8">
                                <TextBlock Text="▶ Run Macro" Foreground="White" FontWeight="SemiBold"/>
                            </Border>

                            <Border Tag="Delay"
                            PreviewMouseMove="SchemePaletteItem_PreviewMouseMove"
                            Background="#343434"
                            CornerRadius="10"
                            Padding="10,7"
                            Margin="0,0,8,8">
                                <TextBlock Text="⏱ Delay" Foreground="White" FontWeight="SemiBold"/>
                            </Border>

                            <Border Tag="KeyPress"
                            PreviewMouseMove="SchemePaletteItem_PreviewMouseMove"
                            Background="#343434"
                            CornerRadius="10"
                            Padding="10,7"
                            Margin="0,0,8,8">
                                <TextBlock Text="⌨ KeyPress" Foreground="White" FontWeight="SemiBold"/>
                            </Border>

                            <Border Tag="KeyDown"
                            PreviewMouseMove="SchemePaletteItem_PreviewMouseMove"
                            Background="#343434"
                            CornerRadius="10"
                            Padding="10,7"
                            Margin="0,0,8,8">
                                <TextBlock Text="⌨↓ KeyDown" Foreground="White" FontWeight="SemiBold"/>
                            </Border>

                            <Border Tag="KeyUp"
                            PreviewMouseMove="SchemePaletteItem_PreviewMouseMove"
                            Background="#343434"
                            CornerRadius="10"
                            Padding="10,7"
                            Margin="0,0,8,8">
                                <TextBlock Text="⌨↑ KeyUp" Foreground="White" FontWeight="SemiBold"/>
                            </Border>

                            <Border Tag="Repeat"
                            PreviewMouseMove="SchemePaletteItem_PreviewMouseMove"
                            Background="#343434"
                            CornerRadius="10"
                            Padding="10,7"
                            Margin="0,0,8,8">
                                <TextBlock Text="⟳ Repeat" Foreground="White" FontWeight="SemiBold"/>
                            </Border>

                            <Border Tag="IfTime"
                            PreviewMouseMove="SchemePaletteItem_PreviewMouseMove"
                            Background="#343434"
                            CornerRadius="10"
                            Padding="10,7"
                            Margin="0,0,8,8">
                                <TextBlock Text="IF Time" Foreground="White" FontWeight="SemiBold"/>
                            </Border>

                            <Border Tag="IfOcrContains"
                            PreviewMouseMove="SchemePaletteItem_PreviewMouseMove"
                            Background="#343434"
                            CornerRadius="10"
                            Padding="10,7"
                            Margin="0,0,8,8">
                                <TextBlock Text="IF OCR Contains" Foreground="White" FontWeight="SemiBold"/>
                            </Border>

                            <Border Tag="IfOcrSame"
                            PreviewMouseMove="SchemePaletteItem_PreviewMouseMove"
                            Background="#343434"
                            CornerRadius="10"
                            Padding="10,7"
                            Margin="0,0,8,8">
                                <TextBlock Text="IF OCR Same" Foreground="White" FontWeight="SemiBold"/>
                            </Border>

                            <Border Tag="IfScreenSame"
                            PreviewMouseMove="SchemePaletteItem_PreviewMouseMove"
                            Background="#343434"
                            CornerRadius="10"
                            Padding="10,7"
                            Margin="0,0,8,8">
                                <TextBlock Text="IF Screen Same" Foreground="White" FontWeight="SemiBold"/>
                            </Border>

                            <Border Tag="Else"
                            PreviewMouseMove="SchemePaletteItem_PreviewMouseMove"
                            Background="#343434"
                            CornerRadius="10"
                            Padding="10,7"
                            Margin="0,0,8,8">
                                <TextBlock Text="ELSE" Foreground="White" FontWeight="SemiBold"/>
                            </Border>

                            <Border Tag="EndIf"
                            PreviewMouseMove="SchemePaletteItem_PreviewMouseMove"
                            Background="#343434"
                            CornerRadius="10"
                            Padding="10,7"
                            Margin="0,0,8,8">
                                <TextBlock Text="ENDIF" Foreground="White" FontWeight="SemiBold"/>
                            </Border>

                            <Border Tag="EndRepeat"
                            PreviewMouseMove="SchemePaletteItem_PreviewMouseMove"
                            Background="#343434"
                            CornerRadius="10"
                            Padding="10,7"
                            Margin="0,0,8,8">
                                <TextBlock Text="END REPEAT" Foreground="White" FontWeight="SemiBold"/>
                            </Border>
                        </WrapPanel>

                        <WrapPanel DockPanel.Dock="Top"
                                   Margin="0,0,0,8">

                            <Button Content="↑ blok"
                                    Command="{Binding MoveSchemeBlockUpCommand}"
                                    Width="75"
                                    Height="32"
                                    Margin="0,0,8,8"/>

                            <Button Content="↓ blok"
                                    Command="{Binding MoveSchemeBlockDownCommand}"
                                    Width="75"
                                    Height="32"
                                    Margin="0,0,8,8"/>
                        </WrapPanel>

                        <DataGrid ItemsSource="{Binding SelectedScheme.Blocks}"
                          SelectedItem="{Binding SelectedSchemeBlock}"
                          AllowDrop="True"
                          DragOver="SchemeBlocks_DragOver"
                          Drop="SchemeBlocks_Drop"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          AlternationCount="2"
                          RowHeight="54"
                          FontSize="14">

                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                    <Setter Property="Tag"
                                    Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>

                                    <Setter Property="ContextMenu">
                                        <Setter.Value>
                                            <ContextMenu>
                                                <MenuItem Header="Usuń blok"
                                                  Command="{Binding PlacementTarget.Tag.DeleteSchemeBlockCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            </ContextMenu>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGrid.RowStyle>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#"
                                            Binding="{Binding Order}"
                                            Width="45"/>

                                <DataGridTextColumn Header=""
                                            Binding="{Binding Icon}"
                                            Width="70"/>

                                <DataGridTextColumn Header="Blok"
                                            Binding="{Binding Name}"
                                            Width="*"/>

                                <DataGridTextColumn Header="Typ"
                                            Binding="{Binding Label}"
                                            Width="150"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </Grid>
        </Border>
        <Border Grid.Column="2"
                Background="#2B2B2B"
                CornerRadius="12"
                Padding="12">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <StackPanel Visibility="{Binding EmptyEditorVisibility}">
                        <TextBlock Text="Wybierz krok makra albo blok schematu"
                                   Foreground="#CCCCCC"
                                   FontSize="16"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Visibility="{Binding StepEditorVisibility}">
                        <TextBlock Text="Edytor kroku"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,12"/>

                        <TextBlock Text="Nazwa kroku"
                                   Foreground="#DDDDDD"
                                   Margin="0,0,0,4"/>

                        <TextBox Text="{Binding SelectedStep.Name, UpdateSourceTrigger=PropertyChanged}"
                                 Height="28"
                                 Margin="0,0,0,10"/>

                        <CheckBox Content="Krok aktywny"
                                  IsChecked="{Binding SelectedStep.IsEnabled}"
                                  Margin="0,0,0,12"/>

                        <TextBlock Text="Tryb / typ akcji"
                                   Foreground="#DDDDDD"
                                   Margin="0,0,0,4"/>

                        <ComboBox ItemsSource="{Binding ActionKinds}"
                                  SelectedItem="{Binding SelectedStepActionKind}"
                                  Height="30"
                                  Margin="0,0,0,14"/>

                        <Separator Margin="0,0,0,12"/>

                        <StackPanel Visibility="{Binding DelayEditorVisibility}">
                            <TextBlock Text="Delay"
                                       Foreground="White"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Stały ms" Foreground="#CCCCCC"/>
                                    <TextBox Text="{Binding DelayMillisecondsParam, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Min ms" Foreground="#CCCCCC"/>
                                    <TextBox Text="{Binding DelayMinMillisecondsParam, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Max ms" Foreground="#CCCCCC"/>
                                    <TextBox Text="{Binding DelayMaxMillisecondsParam, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <StackPanel Visibility="{Binding MoveMouseEditorVisibility}">
                            <TextBlock Text="MoveMouse"
                                       Foreground="White"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Mode" Foreground="#CCCCCC"/>
                                    <ComboBox ItemsSource="{Binding MouseMoveModes}"
                                              SelectedItem="{Binding MoveModeParam}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="X" Foreground="#CCCCCC"/>
                                    <TextBox Text="{Binding MoveXParam, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Y" Foreground="#CCCCCC"/>
                                    <TextBox Text="{Binding MoveYParam, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <StackPanel Visibility="{Binding MouseEditorVisibility}">
                            <TextBlock Text="Mouse"
                                       Foreground="White"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Button" Foreground="#CCCCCC"/>
                                    <ComboBox ItemsSource="{Binding MouseButtons}"
                                              SelectedItem="{Binding MouseButtonParam}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="X opcj." Foreground="#CCCCCC"/>
                                    <TextBox Text="{Binding ClickXParam, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Y opcj." Foreground="#CCCCCC"/>
                                    <TextBox Text="{Binding ClickYParam, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Visibility="{Binding MouseClickDelayEditorVisibility}">
                                <TextBlock Text="Down/Up delay ms" Foreground="#CCCCCC"/>
                                <TextBox Text="{Binding ClickDownUpDelayMillisecondsParam, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,0,12"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Visibility="{Binding KeyboardEditorVisibility}">
                            <TextBlock Text="Keyboard"
                                       Foreground="White"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Key" Foreground="#CCCCCC"/>
                                    <TextBox Text="{Binding KeyParam, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Modifiers" Foreground="#CCCCCC"/>
                                    <TextBox Text="{Binding KeyModifiersParam, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Visibility="{Binding KeyHoldEditorVisibility}">
                                <TextBlock Text="Hold ms" Foreground="#CCCCCC"/>
                                <TextBox Text="{Binding KeyHoldMillisecondsParam, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,0,12"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Visibility="{Binding OcrEditorVisibility}">
                            <TextBlock Text="OCR"
                                       Foreground="White"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6"/>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="X" Foreground="#CCCCCC"/>
                                    <TextBox Text="{Binding OcrXParam, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Y" Foreground="#CCCCCC"/>
                                    <TextBox Text="{Binding OcrYParam, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="W" Foreground="#CCCCCC"/>
                                    <TextBox Text="{Binding OcrWidthParam, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="6">
                                    <TextBlock Text="H" Foreground="#CCCCCC"/>
                                    <TextBox Text="{Binding OcrHeightParam, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Język"
                                       Foreground="#CCCCCC"
                                       Margin="0,0,0,4"/>

                            <TextBox Text="{Binding OcrLanguageParam, UpdateSourceTrigger=PropertyChanged}"
                                     Height="28"
                                     Margin="0,0,0,8"/>

                            <TextBlock Text="Szukany tekst / contains"
                                       Foreground="#CCCCCC"
                                       Margin="0,0,0,4"/>

                            <TextBox Text="{Binding OcrContainsParam, UpdateSourceTrigger=PropertyChanged}"
                                     Height="28"
                                     Margin="0,0,0,12"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Visibility="{Binding SchemeBlockEditorVisibility}">
                        <TextBlock Text="Edytor bloku schematu"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,12"/>

                        <TextBlock Text="Nazwa bloku"
                                   Foreground="#DDDDDD"
                                   Margin="0,0,0,4"/>

                        <TextBox Text="{Binding SelectedSchemeBlockName, UpdateSourceTrigger=PropertyChanged}"
                                 Height="28"
                                 Margin="0,0,0,10"/>

                        <TextBlock Text="Typ bloku"
                                   Foreground="#DDDDDD"
                                   Margin="0,0,0,4"/>

                        <ComboBox ItemsSource="{Binding SchemeBlockKinds}"
                                  SelectedItem="{Binding SelectedSchemeBlockKind}"
                                  Height="30"
                                  Margin="0,0,0,14"/>

                        <StackPanel Visibility="{Binding SchemeRunMacroEditorVisibility}">
                            <TextBlock Text="Makro do uruchomienia"
                                       Foreground="#CCCCCC"
                                       Margin="0,0,0,4"/>

                            <ComboBox ItemsSource="{Binding CurrentMacros}"
                                      SelectedItem="{Binding SchemeBlockMacro}"
                                      DisplayMemberPath="Name"
                                      Height="30"
                                      Margin="0,0,0,12"/>
                        </StackPanel>

                        <StackPanel Visibility="{Binding SchemeDelayEditorVisibility}">
                            <TextBlock Text="Delay"
                                       Foreground="White"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Stały ms" Foreground="#CCCCCC"/>
                                    <TextBox Text="{Binding SchemeDelayMillisecondsParam, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Min ms" Foreground="#CCCCCC"/>
                                    <TextBox Text="{Binding SchemeDelayMinMillisecondsParam, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Max ms" Foreground="#CCCCCC"/>
                                    <TextBox Text="{Binding SchemeDelayMaxMillisecondsParam, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <StackPanel Visibility="{Binding SchemeKeyEditorVisibility}">
                            <TextBlock Text="Keyboard"
                                       Foreground="White"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Key" Foreground="#CCCCCC"/>
                                    <TextBox Text="{Binding SchemeKeyParam, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Modifiers" Foreground="#CCCCCC"/>
                                    <TextBox Text="{Binding SchemeKeyModifiersParam, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Visibility="{Binding SchemeKeyHoldEditorVisibility}">
                                <TextBlock Text="Hold ms" Foreground="#CCCCCC"/>
                                <TextBox Text="{Binding SchemeKeyHoldMillisecondsParam, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,0,12"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Visibility="{Binding SchemeRepeatEditorVisibility}">
                            <TextBlock Text="Repeat"
                                       Foreground="White"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6"/>

                            <TextBlock Text="Ilość powtórzeń"
                                       Foreground="#CCCCCC"
                                       Margin="0,0,0,4"/>

                            <TextBox Text="{Binding SchemeRepeatCountParam, UpdateSourceTrigger=PropertyChanged}"
                                     Height="28"
                                     Margin="0,0,0,12"/>
                        </StackPanel>

                        <StackPanel Visibility="{Binding SchemeIfEditorVisibility}">
                            <TextBlock Text="Warunek IF"
                                       Foreground="White"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6"/>

                            <TextBlock Text="Typ warunku"
                                       Foreground="#CCCCCC"
                                       Margin="0,0,0,4"/>

                            <ComboBox ItemsSource="{Binding SchemeConditionKinds}"
                                      SelectedItem="{Binding SchemeConditionParam}"
                                      Height="30"
                                      Margin="0,0,0,12"/>

                            <StackPanel Visibility="{Binding SchemeIfTimeEditorVisibility}">
                                <TextBlock Text="Milliseconds"
                                           Foreground="#CCCCCC"
                                           Margin="0,0,0,4"/>

                                <TextBox Text="{Binding SchemeTimeMillisecondsParam, UpdateSourceTrigger=PropertyChanged}"
                                         Height="28"
                                         Margin="0,0,0,12"/>
                            </StackPanel>

                            <StackPanel Visibility="{Binding SchemeOcrRegionEditorVisibility}">
                                <TextBlock Text="Region OCR"
                                           Foreground="#CCCCCC"
                                           Margin="0,0,0,4"/>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="X" Foreground="#CCCCCC"/>
                                        <TextBox Text="{Binding SchemeOcrXParam, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Y" Foreground="#CCCCCC"/>
                                        <TextBox Text="{Binding SchemeOcrYParam, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="W" Foreground="#CCCCCC"/>
                                        <TextBox Text="{Binding SchemeOcrWidthParam, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="6">
                                        <TextBlock Text="H" Foreground="#CCCCCC"/>
                                        <TextBox Text="{Binding SchemeOcrHeightParam, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Język"
                                           Foreground="#CCCCCC"
                                           Margin="0,0,0,4"/>

                                <TextBox Text="{Binding SchemeOcrLanguageParam, UpdateSourceTrigger=PropertyChanged}"
                                         Height="28"
                                         Margin="0,0,0,12"/>
                            </StackPanel>

                            <StackPanel Visibility="{Binding SchemeOcrContainsEditorVisibility}">
                                <TextBlock Text="Tekst zawiera"
                                           Foreground="#CCCCCC"
                                           Margin="0,0,0,4"/>

                                <TextBox Text="{Binding SchemeOcrContainsParam, UpdateSourceTrigger=PropertyChanged}"
                                         Height="28"
                                         Margin="0,0,0,12"/>
                            </StackPanel>

                            <StackPanel Visibility="{Binding SchemeOcrSameEditorVisibility}">
                                <TextBlock Text="Przez ile ms tekst ma być taki sam"
                                           Foreground="#CCCCCC"
                                           Margin="0,0,0,4"/>

                                <TextBox Text="{Binding SchemeOcrDurationMillisecondsParam, UpdateSourceTrigger=PropertyChanged}"
                                         Height="28"
                                         Margin="0,0,0,8"/>

                                <TextBlock Text="Co ile ms sprawdzać OCR"
                                           Foreground="#CCCCCC"
                                           Margin="0,0,0,4"/>

                                <TextBox Text="{Binding SchemeOcrPollMillisecondsParam, UpdateSourceTrigger=PropertyChanged}"
                                         Height="28"
                                         Margin="0,0,0,12"/>
                            </StackPanel>

                            <StackPanel Visibility="{Binding SchemeScreenSameEditorVisibility}">
                                <TextBlock Text="Region ekranu"
                                           Foreground="#CCCCCC"
                                           Margin="0,0,0,4"/>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="X" Foreground="#CCCCCC"/>
                                        <TextBox Text="{Binding SchemeScreenXParam, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Y" Foreground="#CCCCCC"/>
                                        <TextBox Text="{Binding SchemeScreenYParam, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="W" Foreground="#CCCCCC"/>
                                        <TextBox Text="{Binding SchemeScreenWidthParam, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="6">
                                        <TextBlock Text="H" Foreground="#CCCCCC"/>
                                        <TextBox Text="{Binding SchemeScreenHeightParam, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Przez ile ms obraz ma być taki sam"
                                           Foreground="#CCCCCC"
                                           Margin="0,0,0,4"/>

                                <TextBox Text="{Binding SchemeScreenDurationMillisecondsParam, UpdateSourceTrigger=PropertyChanged}"
                                         Height="28"
                                         Margin="0,0,0,8"/>

                                <TextBlock Text="Co ile ms sprawdzać ekran"
                                           Foreground="#CCCCCC"
                                           Margin="0,0,0,4"/>

                                <TextBox Text="{Binding SchemeScreenPollMillisecondsParam, UpdateSourceTrigger=PropertyChanged}"
                                         Height="28"
                                         Margin="0,0,0,8"/>

                                <TextBlock Text="Pixel tolerance (0-255)"
                                           Foreground="#CCCCCC"
                                           Margin="0,0,0,4"/>

                                <TextBox Text="{Binding SchemeScreenPixelToleranceParam, UpdateSourceTrigger=PropertyChanged}"
                                         Height="28"
                                         Margin="0,0,0,8"/>

                                <TextBlock Text="Max difference %"
                                           Foreground="#CCCCCC"
                                           Margin="0,0,0,4"/>

                                <TextBox Text="{Binding SchemeScreenMaxDifferencePercentParam, UpdateSourceTrigger=PropertyChanged}"
                                         Height="28"
                                         Margin="0,0,0,12"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Border>

    </Grid>
</Window>